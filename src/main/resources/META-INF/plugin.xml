<idea-plugin>
    <id>com.canal.android.adb.adb-plugin</id>
    <name>ADB +</name>
    <vendor>Romain ZANON</vendor>

    <!--    <description>ADB plugin</description>-->

    <!-- please see https://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.android</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
    </extensions>

    <actions>
        <group id="AdbMenu" text="ADB+" popup="false">
            <add-to-group group-id="MainMenu"/>

            <group id="DeviceMenu" text="Device" popup="true">
                <action id="com.canal.android.adb.action.device.ToggleLayoutBoundsAction"
                        class="com.canal.android.adb.action.device.ToggleLayoutBoundsAction"
                        text="Toggle Layout Bounds"
                        description="Toggle layout bounds"/>
                <action id="com.canal.android.adb.action.device.StandByAction"
                        class="com.canal.android.adb.action.device.StandByAction"
                        text="Stand By"
                        description="Stand by"/>
                <separator/>
                <action id="com.canal.android.adb.action.connectivity.EnableOfflineModeAction"
                        class="com.canal.android.adb.action.connectivity.EnableOfflineModeAction"
                        text="Enable Offline Mode"
                        description="Enable offline mode"/>
                <action id="com.canal.android.adb.action.connectivity.DisableOfflineModeAction"
                        class="com.canal.android.adb.action.connectivity.DisableOfflineModeAction"
                        text="Disable Offline Mode"
                        description="Disable offline mode"/>
                <action id="com.canal.android.adb.action.connectivity.EnableWifiAction"
                        class="com.canal.android.adb.action.connectivity.EnableWifiAction"
                        text="Enable Wifi"
                        description="Enable wifi"/>
                <action id="com.canal.android.adb.action.connectivity.DisableWifiAction"
                        class="com.canal.android.adb.action.connectivity.DisableWifiAction"
                        text="Disable Wifi"
                        description="Disable wifi"/>
                <action id="com.canal.android.adb.action.connectivity.EnableMobileDataAction"
                        class="com.canal.android.adb.action.connectivity.EnableMobileDataAction"
                        text="Enable Mobile Data"
                        description="Enable mobile data"/>
                <action id="com.canal.android.adb.action.connectivity.DisableMobileDataAction"
                        class="com.canal.android.adb.action.connectivity.DisableMobileDataAction"
                        text="Disable Mobile Data"
                        description="Disable mobile data"/>
            </group>

            <group id="DeeplinkMenu" text="Deeplink" popup="true">
                <action id="com.canal.android.adb.action.deeplink.DeeplinkSettingsAction"
                        class="com.canal.android.adb.action.deeplink.DeeplinkSettingsAction"
                        text="Settings"
                        description="Open android settings"/>
                <action id="com.canal.android.adb.action.deeplink.DeeplinkAllAppsAction"
                        class="com.canal.android.adb.action.deeplink.DeeplinkAllAppsAction"
                        text="All Apps"
                        description="Open all apps page"/>
            </group>

            <group id="CanalMenu" text="Canal" popup="true">
                <action id="com.canal.android.adb.action.canal.DebugWipeDataAction"
                        class="com.canal.android.adb.action.canal.DebugWipeDataAction"
                        text="Debug Wipe Data"/>
                <action id="com.canal.android.adb.action.canal.DebugUninstallAction"
                        class="com.canal.android.adb.action.canal.DebugUninstallAction"
                        text="Debug Uninstall App"/>
                <separator/>
                <action id="com.canal.android.adb.action.canal.CharlesWipeDataAction"
                        class="com.canal.android.adb.action.canal.CharlesWipeDataAction"
                        text="Charles Wipe Data"/>
                <action id="com.canal.android.adb.action.canal.CharlesUninstallAction"
                        class="com.canal.android.adb.action.canal.CharlesUninstallAction"
                        text="Charles Uninstall App"/>
                <separator/>
                <action id="com.canal.android.adb.action.canal.ReleaseWipeDataAction"
                        class="com.canal.android.adb.action.canal.ReleaseWipeDataAction"
                        text="Release Wipe Data"/>
                <action id="com.canal.android.adb.action.canal.ReleaseUninstallAction"
                        class="com.canal.android.adb.action.canal.ReleaseUninstallAction"
                        text="Release Uninstall App"/>
                <separator/>
                <action id="com.canal.android.adb.action.canal.BoxWipeDataAction"
                        class="com.canal.android.adb.action.canal.BoxWipeDataAction"
                        text="Box Wipe Data"/>
                <action id="com.canal.android.adb.action.canal.BoxUninstallAction"
                        class="com.canal.android.adb.action.canal.BoxUninstallAction"
                        text="Box Uninstall App"/>
            </group>

        </group>

    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                instance="com.canal.android.adb.setting.AdbPluginSettingsConfigurable"
                id="org.intellij.sdk.settings.AppSettingsConfigurable"
                displayName="ADB+"/>
        <applicationService
                serviceImplementation="com.canal.android.adb.setting.AdbPluginSettingsState"/>
    </extensions>

</idea-plugin>