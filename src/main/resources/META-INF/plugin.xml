<idea-plugin>
    <id>com.canal.android.adb.adb-plugin</id>
    <name>ADB +</name>
    <vendor>Canal</vendor>

    <!--    <description>ADB plugin</description>-->

    <!-- please see https://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.android</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
    </extensions>

    <actions>
        <group id="AdbMenu" text="ADB+" popup="false">
            <add-to-group group-id="MainMenu"/>

            <group id="DeviceMenu" text="Device" popup="true">
                <action id="com.canal.android.adb.action.ToggleLayoutBoundsAction"
                        class="com.canal.android.adb.action.ToggleLayoutBoundsAction"
                        text="Toggle Layout Bounds"
                        description="Toggle layout bounds"/>
                <action id="com.canal.android.adb.action.StandByAction"
                        class="com.canal.android.adb.action.StandByAction"
                        text="Stand By"
                        description="Stand by"/>
                <separator/>
                <action id="com.canal.android.adb.action.EnableOfflineModeAction"
                        class="com.canal.android.adb.action.EnableOfflineModeAction"
                        text="Enable Offline Mode"
                        description="Enable offline mode"/>
                <action id="com.canal.android.adb.action.DisableOfflineModeAction"
                        class="com.canal.android.adb.action.DisableOfflineModeAction"
                        text="Disable Offline Mode"
                        description="Disable offline mode"/>
                <action id="com.canal.android.adb.action.EnableWifiAction"
                        class="com.canal.android.adb.action.EnableWifiAction"
                        text="Enable Wifi"
                        description="Enable wifi"/>
                <action id="com.canal.android.adb.action.DisableWifiAction"
                        class="com.canal.android.adb.action.DisableWifiAction"
                        text="Disable Wifi"
                        description="Disable wifi"/>
                <action id="com.canal.android.adb.action.EnableMobileDataAction"
                        class="com.canal.android.adb.action.EnableMobileDataAction"
                        text="Enable Mobile Data"
                        description="Enable mobile data"/>
                <action id="com.canal.android.adb.action.DisableMobileDataAction"
                        class="com.canal.android.adb.action.DisableMobileDataAction"
                        text="Disable Mobile Data"
                        description="Disable mobile data"/>
            </group>

            <group id="DeeplinkMenu" text="Deeplink" popup="true">
                <action id="com.canal.android.adb.action.DeeplinkSettingsAction"
                        class="com.canal.android.adb.action.DeeplinkSettingsAction"
                        text="Settings"
                        description="Open android settings"/>
                <action id="com.canal.android.adb.action.DeeplinkAllAppsAction"
                        class="com.canal.android.adb.action.DeeplinkAllAppsAction"
                        text="All Apps"
                        description="Open all apps page"/>
            </group>

        </group>


    </actions>
</idea-plugin>