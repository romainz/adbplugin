<idea-plugin>
    <id>com.zanon.android.adb.adb-plugin</id>
    <name>ADB +</name>
    <vendor>Romain ZANON</vendor>

    <!--    <description>ADB plugin</description>-->

    <!-- please see https://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.android</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
    </extensions>

    <actions>
        <group id="AdbMenu" text="ADB+" popup="false">
            <add-to-group group-id="MainMenu"/>

            <group id="DeviceMenu" text="Device" popup="true">
                <action id="com.zanon.android.adb.action.device.AdbConnectAction"
                        class="com.zanon.android.adb.action.device.AdbConnectAction"
                        text="Connect"
                        description="Connect device"/>
                <action id="com.zanon.android.adb.action.device.AdbDisconnectAction"
                        class="com.zanon.android.adb.action.device.AdbDisconnectAction"
                        text="Disconnect"
                        description="Disconnect device"/>
                <separator/>
                <action id="com.zanon.android.adb.action.device.InputTextAction"
                        class="com.zanon.android.adb.action.device.InputTextAction"
                        text="Input Text"
                        description="Input text"/>
                <action id="com.zanon.android.adb.action.device.ToggleLayoutBoundsAction"
                        class="com.zanon.android.adb.action.device.ToggleLayoutBoundsAction"
                        text="Toggle Layout Bounds"
                        description="Toggle layout bounds"/>
                <action id="com.zanon.android.adb.action.device.StandByAction"
                        class="com.zanon.android.adb.action.device.StandByAction"
                        text="Stand By"
                        description="Stand by"/>
                <separator/>
                <action id="com.zanon.android.adb.action.connectivity.EnableOfflineModeAction"
                        class="com.zanon.android.adb.action.connectivity.EnableOfflineModeAction"
                        text="Enable Offline Mode"
                        description="Enable offline mode"/>
                <action id="com.zanon.android.adb.action.connectivity.DisableOfflineModeAction"
                        class="com.zanon.android.adb.action.connectivity.DisableOfflineModeAction"
                        text="Disable Offline Mode"
                        description="Disable offline mode"/>
                <action id="com.zanon.android.adb.action.connectivity.EnableWifiAction"
                        class="com.zanon.android.adb.action.connectivity.EnableWifiAction"
                        text="Enable Wifi"
                        description="Enable wifi"/>
                <action id="com.zanon.android.adb.action.connectivity.DisableWifiAction"
                        class="com.zanon.android.adb.action.connectivity.DisableWifiAction"
                        text="Disable Wifi"
                        description="Disable wifi"/>
                <action id="com.zanon.android.adb.action.connectivity.EnableMobileDataAction"
                        class="com.zanon.android.adb.action.connectivity.EnableMobileDataAction"
                        text="Enable Mobile Data"
                        description="Enable mobile data"/>
                <action id="com.zanon.android.adb.action.connectivity.DisableMobileDataAction"
                        class="com.zanon.android.adb.action.connectivity.DisableMobileDataAction"
                        text="Disable Mobile Data"
                        description="Disable mobile data"/>
            </group>

            <group id="DeeplinkMenu" text="Deeplink" popup="true">
                <action id="com.zanon.android.adb.action.deeplink.DeeplinkCustomAction"
                        class="com.zanon.android.adb.action.deeplink.DeeplinkCustomAction"
                        text="Custom Deeplink"/>
                <separator/>
                <action id="com.zanon.android.adb.action.deeplink.DeeplinkAllAppsAction"
                        class="com.zanon.android.adb.action.deeplink.DeeplinkAllAppsAction"
                        text="All Apps"
                        description="Open all apps page"/>
                <action id="com.zanon.android.adb.action.deeplink.DeeplinkDevelopmentSettingsAction"
                        class="com.zanon.android.adb.action.deeplink.DeeplinkDevelopmentSettingsAction"
                        text="Development Settings"
                        description="Open developement settings page"/>
                <action id="com.zanon.android.adb.action.deeplink.DeeplinkDeviceInfoAction"
                        class="com.zanon.android.adb.action.deeplink.DeeplinkDeviceInfoAction"
                        text="Device Information"
                        description="Open device information page"/>
                <action id="com.zanon.android.adb.action.deeplink.DeeplinkLanguageAction"
                        class="com.zanon.android.adb.action.deeplink.DeeplinkLanguageAction"
                        text="Language"
                        description="Open language page"/>
                <action id="com.zanon.android.adb.action.deeplink.DeeplinkSettingsAction"
                        class="com.zanon.android.adb.action.deeplink.DeeplinkSettingsAction"
                        text="Settings"
                        description="Open android settings"/>
                <action id="com.zanon.android.adb.action.deeplink.DeeplinkWifiAction"
                        class="com.zanon.android.adb.action.deeplink.DeeplinkWifiAction"
                        text="Wifi Settings"
                        description="Open Wifi settings"/>
            </group>

            <group id="ApplicationMenu" text="Application" popup="true">
                <action id="com.zanon.android.adb.action.application.WipeDataAction"
                        class="com.zanon.android.adb.action.application.WipeDataAction"
                        text="Wipe Data"/>
                <action id="com.zanon.android.adb.action.application.UninstallAction"
                        class="com.zanon.android.adb.action.application.UninstallAction"
                        text="Uninstall"/>
                <action id="com.zanon.android.adb.action.application.ForceStopAction"
                        class="com.zanon.android.adb.action.application.ForceStopAction"
                        text="Force Stop"/>
                <action id="com.zanon.android.adb.action.application.StartApplicationAction"
                        class="com.zanon.android.adb.action.application.StartApplicationAction"
                        text="Start"/>
            </group>

        </group>

    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                instance="com.zanon.android.adb.setting.AdbPluginSettingsConfigurable"
                id="org.intellij.sdk.settings.AppSettingsConfigurable"
                displayName="ADB+"/>
        <applicationService
                serviceImplementation="com.zanon.android.adb.setting.AdbPluginSettingsState"/>
    </extensions>

</idea-plugin>